{
  "name": "minecraaft",
  "version": "1.0.0",
  "description": "minecrAft — Adyah's Adventure. A native voxel building & adventure game for Adyah.",
  "author": "Karthik (for Adyah)",
  "license": "MIT",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "dist:all": "electron-builder -mw"
  },
  "devDependencies": {
    "electron": "^30.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.adyah.minecraaft",
    "productName": "minecrAft - Adyah's Adventure",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "src/**/*"
    ],
    "mac": {
      "target": ["dmg", "zip"],
      "category": "public.app-category.games",
      "icon": "build/icon.png"
    },
    "win": {
      "target": ["nsis", "portable"],
      "icon": "build/icon.png"
    },
    "linux": {
      "target": ["AppImage"],
      "category": "Game"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "minecrAft - Adyah's Adventure"
    }
  }
}
